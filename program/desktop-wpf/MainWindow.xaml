<Window x:Class="WarrantyReturns.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт возвратов и гарантийных случаев"
        Height="720"
        Width="1180"
        MinHeight="640"
        MinWidth="1000">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="Система учёта возвратов и гарантийных случаев товаров"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold" />
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Right"
                           Foreground="#DBEAFE"
                           FontSize="13"
                           HorizontalAlignment="Right"
                           Text="manager: готово" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBox x:Name="SearchBox"
                             Width="260"
                             Margin="0,0,8,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Поиск по клиенту, товару или серийному номеру"
                             TextChanged="SearchBox_OnTextChanged" />
                    <ComboBox x:Name="StatusFilterBox"
                              Width="190"
                              Margin="0,0,8,0"
                              SelectionChanged="StatusFilterBox_OnSelectionChanged" />
                    <ComboBox x:Name="ReasonFilterBox"
                              Width="210"
                              Margin="0,0,8,0"
                              SelectionChanged="ReasonFilterBox_OnSelectionChanged" />
                    <DatePicker x:Name="DateFromPicker"
                                Width="130"
                                Margin="0,0,8,0"
                                SelectedDateChanged="DateFilter_OnSelectedDateChanged" />
                    <DatePicker x:Name="DateToPicker"
                                Width="130"
                                Margin="0,0,8,0"
                                SelectedDateChanged="DateFilter_OnSelectedDateChanged" />
                    <Button Content="Сбросить" Width="90" Click="ResetFilter_OnClick" />
                </WrapPanel>

                <DataGrid x:Name="CasesGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionChanged="CasesGrid_OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="120" />
                        <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="160" />
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="130" />
                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="180" />
                        <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="180" />
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150" />
                        <DataGridTextColumn Header="Дата" Binding="{Binding ReceivedAt, StringFormat=dd.MM.yyyy}" Width="100" />
                        <DataGridTextColumn Header="Сумма" Binding="{Binding CheckSum}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="12" Padding="16" BorderBrush="#CBD5E1" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Карточка заявки" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />

                        <TextBlock Text="Клиент / организация" />
                        <TextBox x:Name="ClientBox" Margin="0,4,0,10" />

                        <TextBlock Text="Телефон (+7XXXXXXXXXX)" />
                        <TextBox x:Name="PhoneBox" Margin="0,4,0,10" />

                        <TextBlock Text="Товар" />
                        <TextBox x:Name="ProductBox" Margin="0,4,0,10" />

                        <TextBlock Text="Серийный номер" />
                        <TextBox x:Name="SerialBox" Margin="0,4,0,10" />

                        <TextBlock Text="Причина обращения" />
                        <ComboBox x:Name="ReasonBox" Margin="0,4,0,10" />

                        <TextBlock Text="Статус" />
                        <ComboBox x:Name="StatusBox" Margin="0,4,0,10" />

                        <TextBlock Text="Сумма чека" />
                        <TextBox x:Name="SumBox" Margin="0,4,0,10" />

                        <TextBlock Text="Дата приёма товара" />
                        <DatePicker x:Name="ReceivedDatePicker" Margin="0,4,0,10" />

                        <CheckBox x:Name="SupplierApprovalBox"
                                  Content="Требует согласования с поставщиком"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="Внутренний комментарий менеджера (до 400 символов)" />
                        <TextBox x:Name="InternalCommentBox"
                                 Height="70"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,4,0,10" />

                        <TextBlock Text="Внешний комментарий для инженера/клиента (до 300 символов)" />
                        <TextBox x:Name="ExternalCommentBox"
                                 Height="70"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,4,0,10" />

                        <TextBlock Text="Техническое заключение инженера" />
                        <TextBox x:Name="ConclusionBox"
                                 Height="70"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,4,0,14" />

                        <WrapPanel>
                            <Button Content="Новая" Width="84" Margin="0,0,8,8" Click="NewCase_OnClick" />
                            <Button Content="Сохранить" Width="100" Margin="0,0,8,8" Click="SaveCase_OnClick" />
                            <Button Content="Удалить" Width="90" Margin="0,0,8,8" Click="DeleteCase_OnClick" />
                            <Button Content="Синхр." Width="90" Margin="0,0,8,8" Click="Sync_OnClick" />
                            <Button Content="Аналитика" Width="100" Margin="0,0,8,8" Click="Analytics_OnClick" />
                            <Button Content="DOCX" Width="80" Margin="0,0,8,8" Click="ExportDocx_OnClick" />
                            <Button Content="XLSX" Width="80" Margin="0,0,8,8" Click="ExportXlsx_OnClick" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="#64748B"
                   Text="Данные сохраняются локально и синхронизируются с файлом program/cloud/warranty_cases.json" />
    </Grid>
</Window>
